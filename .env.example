# Copy this file to .env and fill in your own values.
# .env is gitignored — it never gets committed.

CAMERA_IP=192.168.1.100
PORT=5050
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
MEDIA_DIR=~/Movies/LumixSessions
OBS_RECORDING_DIR=~/Movies

# Optional — required for iPhone Motion Control (needs HTTPS).
# Generate with mkcert; see SETUP.md → "Enable HTTPS for Motion Control".
SSL_CERT_FILE=
SSL_KEY_FILE=
MOTION_MAX_DEG=45
